# Browser-visible API base. Point it at the Prism mock during Sprint 0:
#   pnpm --filter ecolife-server mock   →   http://localhost:4010/api/v1
# Leave it empty to use the same-origin Next route handlers under /api instead.
NEXT_PUBLIC_API_URL=

# Server-side only. The base URL this Next server uses to reach ecolife-server
# from inside the network. Never exposed to the browser.
API_URL_INTERNAL=

# Browser-visible Sentry DSN. Empty disables reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Lets this server assert the end user's IP to ecolife-server via
# x-ecolife-client-ip. Must match INTERNAL_PROXY_TOKEN in ecolife-server.
# Without it the backend ignores the IP and uses the socket address.
INTERNAL_PROXY_TOKEN=
# Proxy hops WE operate, counted from the right of x-forwarded-for.
# 0 on Vercel (the platform header is used instead). Never parse from the left.
TRUSTED_PROXY_HOPS=0
